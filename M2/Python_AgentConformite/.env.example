# Copier ce fichier en .env et renseigner les valeurs. Le fichier .env n'est JAMAIS versionné.
# Sans ANTHROPIC_API_KEY, l'application démarre en mode démonstration (relit demo/, aucun appel API).

ANTHROPIC_API_KEY=

# Modèles (vérifier les identifiants disponibles avec scripts/verif_initiale.py)
MODELE_EXTRACTION=claude-sonnet-5-5
MODELE_MECANIQUE=claude-haiku-4-5-20251001
MODELE_ARBITRE=claude-opus-5-5

# Budget (USD par mois) et seuil d'alerte de verifier_budget()
BUDGET_MENSUEL_USD=250
SEUIL_BUDGET=0.9

# Mode démonstration forcé (1) ou non (0)
MODE_DEMO=0

# Traçage LangSmith (métadonnées seulement), facultatif
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=projet-conformite
